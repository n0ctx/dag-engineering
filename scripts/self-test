#!/usr/bin/env python3
import copy
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import subprocess
import tempfile
import unittest
from concurrent.futures import ThreadPoolExecutor


SCRIPTS = Path(__file__).resolve().parent


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def node(node_id, *, depends=(), conflicts=(), files=None):
    return {
        "id": node_id,
        "title": f"Node {node_id}",
        "objective": f"Deliver {node_id}",
        "work_type": "implementation",
        "scope": {"files": list(files) if files else [f"src/{node_id}.py"], "forbidden": []},
        "read_first": [],
        "depends_on": list(depends),
        "conflicts_with": list(conflicts),
        "inputs": [],
        "outputs": [f"output {node_id}"],
        "acceptance": [{"id": "AC1", "criterion": f"{node_id} works"}],
        "verification": [{"id": "V1", "run": "true", "expect": "exit 0", "covers": ["AC1"]}],
        "status": "pending",
        "attempts": [],
        "handoff": {
            "status": None,
            "ref": None,
            "verification_refs": [],
            "commit": None,
            "summary": None,
            "failure_reason": None,
            "updated_at": None,
        },
    }


def dag(nodes):
    timestamp = now()
    return {
        "schema_version": 1,
        "dag_id": "fixture",
        "objective": "Exercise runtime",
        "source_refs": [".dag/sources/fixture.md"],
        "assumptions": [],
        "global_acceptance": [{"id": "G1", "criterion": "runtime behaves"}],
        "planning_status": "approved",
        "approval_ref": "fixture approval",
        "planning_session": None,
        "decomposition_review": None,
        "max_parallel": 3,
        "created_at": timestamp,
        "updated_at": timestamp,
        "convergence": {"status": "pending", "verification_ref": None, "checked_at": None, "gaps": []},
        "nodes": nodes,
    }


class RuntimeTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.root = Path(self.temp.name)
        subprocess.run(["git", "init", "-q", str(self.root)], check=True)
        subprocess.run(["git", "-C", str(self.root), "config", "user.email", "fixture@example.com"], check=True)
        subprocess.run(["git", "-C", str(self.root), "config", "user.name", "Fixture"], check=True)
        (self.root / "README.md").write_text("fixture\n", encoding="utf-8")
        subprocess.run(["git", "-C", str(self.root), "add", "README.md"], check=True)
        subprocess.run(["git", "-C", str(self.root), "commit", "-qm", "baseline"], check=True)
        self.path = self.root / ".dag" / "dag.json"
        self.path.parent.mkdir()
        sources = self.path.parent / "sources"
        sources.mkdir()
        (sources / "fixture.md").write_text("fixture source\n", encoding="utf-8")
        self.session = "session-exec"

    def tearDown(self):
        self.temp.cleanup()

    def write(self, value):
        self.path.write_text(json.dumps(value), encoding="utf-8")
        self.run_cmd("update-task", "--reseal", "--reason", "fixture")

    def run_cmd(self, command, *args, expect=0):
        result = subprocess.run(
            [str(SCRIPTS / command), "--dag", str(self.path), *args],
            text=True,
            capture_output=True,
            env={**os.environ, "CLAUDE_CODE_SESSION_ID": self.session},
        )
        self.assertEqual(result.returncode, expect, result.stdout + result.stderr)
        return result

    def start(self, node_id):
        return self.run_cmd("update-task", node_id, "running", "--worktree", str(self.root))

    def commit_node(self, node_id):
        path = self.root / "src" / f"{node_id}.py"
        path.parent.mkdir(exist_ok=True)
        count = subprocess.run(
            ["git", "-C", str(self.root), "rev-list", "--count", "HEAD"],
            text=True, capture_output=True, check=True,
        ).stdout.strip()
        path.write_text(f"VALUE = {node_id!r}\nREVISION = {count}\n", encoding="utf-8")
        subprocess.run(["git", "-C", str(self.root), "add", str(path.relative_to(self.root))], check=True)
        subprocess.run(["git", "-C", str(self.root), "commit", "-qm", f"deliver {node_id}"], check=True)
        return subprocess.run(
            ["git", "-C", str(self.root), "rev-parse", "HEAD"], text=True, capture_output=True, check=True
        ).stdout.strip()

    def artifacts(self, node_id, head, *, round_number=1, approved=True,
                  blocking=None, escalations=None, context_used=(), contract=()):
        folder = self.root / ".dag" / "artifacts" / node_id
        folder.mkdir(parents=True, exist_ok=True)
        handoff = folder / f"handoff-{round_number}.json"
        handoff.write_text(json.dumps({
            "node": node_id,
            "status": "DONE",
            "files_changed": [f"src/{node_id}.py"],
            "outputs": [f"output {node_id}"],
            "decisions": [],
            "verification": [{"command": "fixture check", "result": "exit 0"}],
            "context_used": list(context_used),
            "concerns": [],
            "unresolved": [],
            "downstream_notes": [],
            "commit": head,
        }), encoding="utf-8")
        if blocking is None:
            blocking = [] if approved else [
                {"id": f"code-{round_number}", "severity": "critical", "path": f"src/{node_id}.py", "detail": "fixture defect"}
            ]
        blocking = [
            {"id": finding.get("id", f"code-{index}"), **finding}
            for index, finding in enumerate(blocking, 1)
        ]
        escalations = [
            {"id": finding.get("id", f"caller-{index}"), **finding}
            for index, finding in enumerate(escalations or [], 1)
        ]
        contract = [
            {"id": finding.get("id", f"contract-{index}"), **finding}
            for index, finding in enumerate(contract, 1)
        ]
        resolutions = []
        if round_number > 1:
            state = json.loads(self.path.read_text())
            current = next(item for item in state["nodes"] if item["id"] == node_id)
            previous = current["attempts"][-1]["reviews"][-1]
            resolutions = [
                {"id": finding_id, "status": "ADDRESSED", "detail": "fixed in this head"}
                for finding_id in previous.get("blocking_finding_ids", [])
            ]
        review = folder / f"review-{round_number}.json"
        review.write_text(json.dumps({
            "node": node_id,
            "head_ref": head,
            "round": round_number,
            "spec": "CANNOT_VERIFY" if contract else ("APPROVED" if approved else "NEEDS_FIXES"),
            "quality": "APPROVED" if approved else "NEEDS_FIXES",
            "blocking_findings": blocking,
            "controller_decisions": escalations,
            "contract_findings": contract,
            "minor_findings": [],
            "out_of_scope_observations": [],
            "resolutions": resolutions,
        }), encoding="utf-8")
        master = folder / "master.json"
        master.write_text(json.dumps({
            "node": node_id,
            "head_ref": head,
            "checked_at": now(),
            "acceptance_ids": ["AC1"],
            "checks": [{"command": "fixture check", "exit_code": 0, "result": "passed"}],
            "scope_files": [f"src/{node_id}.py"],
        }), encoding="utf-8")
        return tuple(str(path.relative_to(self.root)) for path in (handoff, review, master))

    def complete(self, node_id):
        self.start(node_id)
        head = self.commit_node(node_id)
        handoff, review, master = self.artifacts(node_id, head)
        self.run_cmd(
            "update-task", node_id, "review", "--handoff-ref", handoff,
            "--review-ref", review, "--head-ref", head,
        )
        self.run_cmd(
            "update-task", node_id, "done", "--handoff-ref", handoff,
            "--verification-ref", master, "--head-ref", head, "--summary", f"{node_id} delivered",
        )
        return head

    def test_happy_path_and_ready_dependency(self):
        self.write(dag([node("A"), node("B"), node("C", depends=("A", "B")), node("D")]))
        self.run_cmd("validate-dag")
        ready = json.loads(self.run_cmd("ready-tasks", "--json").stdout)
        self.assertEqual([item["id"] for item in ready["candidates"]], ["A", "B", "D"])

    def test_cycle_and_missing_dependency_fail(self):
        cycle = dag([node("A", depends=("B",)), node("B", depends=("A",))])
        self.write(cycle)
        result = self.run_cmd("validate-dag", expect=1)
        self.assertIn("cycle", result.stderr)
        missing = dag([node("A", depends=("missing",))])
        self.write(missing)
        result = self.run_cmd("validate-dag", expect=1)
        self.assertIn("unknown node", result.stderr)

    def test_self_dependency_and_invalid_status_fail(self):
        self_ref = dag([node("A", depends=("A",))])
        self.write(self_ref)
        result = self.run_cmd("validate-dag", expect=1)
        self.assertIn("self-reference", result.stderr)
        invalid = dag([node("A")])
        invalid["nodes"][0]["status"] = "ready"
        self.write(invalid)
        result = self.run_cmd("validate-dag", expect=1)
        self.assertIn("invalid value 'ready'", result.stderr)

    def test_ephemeral_source_label_fails(self):
        value = dag([node("A")])
        value["source_refs"] = ["user-request: 2026-09-08"]
        self.write(value)
        result = self.run_cmd("validate-dag", expect=1)
        self.assertIn("durable project path", result.stderr)

    def test_conflict_excludes_only_active_peer(self):
        self.write(dag([node("A", conflicts=("B",)), node("B", conflicts=("A",))]))
        initial = json.loads(self.run_cmd("ready-tasks", "--json").stdout)
        self.assertEqual([item["id"] for item in initial["candidates"]], ["A", "B"])
        self.start("A")
        active = json.loads(self.run_cmd("ready-tasks", "--json").stdout)
        self.assertEqual(active["candidates"], [])

    def test_overlapping_scope_without_conflict_edge_fails(self):
        self.write(dag([node("A", files=["src/**"]), node("B", files=["src/auth/*.py"])]))
        result = self.run_cmd("validate-dag", expect=1)
        self.assertIn("scopes overlap", result.stderr)

    def test_overlapping_scope_is_allowed_when_ordered_or_declared(self):
        self.write(
            dag([
                node("A", files=["src/**"], conflicts=("B",)),
                node("B", files=["src/auth/*.py"], conflicts=("A",)),
            ])
        )
        self.run_cmd("validate-dag")
        self.write(dag([node("A", files=["src/**"]), node("B", files=["src/auth/*.py"], depends=("A",))]))
        self.run_cmd("validate-dag")

    def test_disjoint_patterns_are_not_reported_as_conflicts(self):
        self.write(dag([node("A", files=["src/**/*.py"]), node("B", files=["src/**/*.md"])]))
        self.run_cmd("validate-dag")
        self.write(dag([node("A", files=["src/auth/**"]), node("B", files=["src/billing/**"])]))
        self.run_cmd("validate-dag")

    def test_done_node_cannot_collide_with_a_pending_peer(self):
        self.write(
            dag([
                node("A", files=["src/**"], conflicts=("B",)),
                node("B", files=["src/auth/*.py"], conflicts=("A",)),
            ])
        )
        self.complete("A")
        value = json.loads(self.path.read_text())
        for entry in value["nodes"]:
            entry["conflicts_with"] = []
        self.write(value)
        self.run_cmd("validate-dag")

    def test_status_roadmap_layers_follow_dependencies(self):
        self.write(
            dag([
                node("A"),
                node("B", conflicts=("A",), files=["lib/b.py"]),
                node("C", depends=("A", "B")),
                node("D", depends=("C",)),
            ])
        )
        value = json.loads(self.path.read_text())
        value["nodes"][1]["conflicts_with"] = ["A"]
        value["nodes"][0]["conflicts_with"] = ["B"]
        self.write(value)
        status = json.loads(self.run_cmd("status", "--json").stdout)
        self.assertEqual(
            [[entry["id"] for entry in layer["nodes"]] for layer in status["roadmap"]],
            [["A", "B"], ["C"], ["D"]],
        )
        first = status["roadmap"][0]["nodes"]
        self.assertEqual([entry["unlocks"] for entry in first], [["C"], ["C"]])
        self.assertTrue(all(entry["ready"] for entry in first))
        self.assertFalse(status["roadmap"][1]["nodes"][0]["ready"])
        text = self.run_cmd("status").stdout
        self.assertIn("Layer 0:", text)
        self.assertIn("A: Node A (ready) -> C", text)

    def design_review(self, findings=(), dag_id="fixture"):
        review_dir = self.root / ".dag" / "artifacts" / "design-review"
        review_dir.mkdir(parents=True, exist_ok=True)
        state = json.loads(self.path.read_text())
        pending = state.get("decomposition_review") or {}
        mode = pending.get("mode") if pending.get("verdict") is None else "full"
        mode = mode or "full"
        lanes = pending.get("required_lanes") or ["requirements", "graph", "execution"]
        plan = json.loads(self.run_cmd("status", "--plan-view").stdout)
        fingerprint = plan["plan_fingerprint"]
        grouped = {lane: [] for lane in lanes}
        kind_lanes = {
            "coverage": "requirements", "assumption_laundering": "requirements",
            "missing_dependency": "graph", "fabricated_dependency": "graph", "granularity": "graph",
            "acceptance": "execution", "context": "execution", "scope_realism": "execution",
        }
        for index, raw in enumerate(findings, 1):
            finding = {"id": raw.get("id", f"finding-{index}"), **raw}
            lane = finding.pop("lane", kind_lanes.get(finding.get("kind"), lanes[0]))
            grouped[lane].append(finding)
        entries = []
        for lane in lanes:
            report = {
                "dag_id": dag_id,
                "plan_fingerprint": fingerprint,
                "mode": mode,
                "lane": lane,
                "findings": grouped[lane],
                "checks_performed": [f"{lane} checks"],
            }
            if mode == "repair":
                report["resolutions"] = [
                    {"id": finding["id"], "status": "ADDRESSED", "detail": "fixed by the amendment"}
                    for finding in pending.get("open_findings", []) if finding["lane"] == lane
                ]
            artifact = review_dir / f"{mode}-{lane}.json"
            artifact.write_text(json.dumps(report), encoding="utf-8")
            entries.append({"lane": lane, "ref": str(artifact.relative_to(self.root))})
        manifest = review_dir / f"{mode}-manifest.json"
        manifest.write_text(json.dumps({
            "dag_id": dag_id,
            "plan_fingerprint": fingerprint,
            "mode": mode,
            "reviews": entries,
        }), encoding="utf-8")
        ref = str(manifest.relative_to(self.root))
        self.run_cmd("update-task", "--decomposition-review", ref)
        return ref

    def approve_as(self, session):
        approval = self.root / ".dag" / "sources" / "approval.md"
        approval.parent.mkdir(parents=True, exist_ok=True)
        approval.write_text("approved\n", encoding="utf-8")
        previous, self.session = self.session, session
        current = json.loads(self.path.read_text()).get("decomposition_review")
        if not current or current.get("verdict") != "approved":
            self.design_review()
        self.run_cmd("update-task", "--planning-status", "approved", "--reference", ".dag/sources/approval.md")
        self.session = previous

    def awaiting(self, nodes):
        value = dag(nodes)
        value["planning_status"] = "awaiting_approval"
        value["approval_ref"] = None
        self.write(value)

    def test_approval_stamps_the_planning_session(self):
        self.awaiting([node("A")])
        self.approve_as("session-plan")
        self.assertEqual(json.loads(self.path.read_text())["planning_session"], "session-plan")

    def test_planning_session_cannot_execute_its_own_dag(self):
        self.awaiting([node("A")])
        self.approve_as("session-plan")
        self.session = "session-plan"
        result = self.run_cmd("update-task", "A", "running", "--worktree", str(self.root), expect=3)
        self.assertIn("start a new session", result.stderr)
        self.session = "session-exec"
        self.start("A")
        self.assertEqual(json.loads(self.path.read_text())["nodes"][0]["status"], "running")

    def test_session_gate_fails_open_without_a_session_id(self):
        self.awaiting([node("A")])
        approval = self.root / ".dag" / "sources" / "approval.md"
        approval.parent.mkdir(parents=True, exist_ok=True)
        approval.write_text("approved\n", encoding="utf-8")
        self.design_review()
        environment = {key: value for key, value in os.environ.items() if key != "CLAUDE_CODE_SESSION_ID"}
        for args in (
            ("--planning-status", "approved", "--reference", ".dag/sources/approval.md"),
            ("A", "running", "--worktree", str(self.root)),
        ):
            result = subprocess.run(
                [str(SCRIPTS / "update-task"), "--dag", str(self.path), *args],
                text=True,
                capture_output=True,
                env=environment,
            )
            self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        saved = json.loads(self.path.read_text())
        self.assertIsNone(saved["planning_session"])
        self.assertEqual(saved["nodes"][0]["status"], "running")

    def test_amend_keeps_the_original_planning_session(self):
        self.awaiting([node("A")])
        self.approve_as("session-plan")
        self.complete("A")
        report = self.root / ".dag" / "artifacts" / "convergence.md"
        report.parent.mkdir(parents=True, exist_ok=True)
        report.write_text("gap\n", encoding="utf-8")
        self.run_cmd(
            "update-task", "--convergence", "failed",
            "--reference", ".dag/artifacts/convergence.md", "--gap", "missing integration",
        )
        self.approve_as("session-exec")
        self.assertEqual(json.loads(self.path.read_text())["planning_session"], "session-plan")

    def run_in(self, cwd, command, *args, expect=0):
        result = subprocess.run(
            [str(SCRIPTS / command), *args],
            text=True,
            capture_output=True,
            cwd=str(cwd),
            env={**os.environ, "CLAUDE_CODE_SESSION_ID": self.session},
        )
        self.assertEqual(result.returncode, expect, result.stdout + result.stderr)
        return result

    def linked_worktree(self, name):
        holder = tempfile.TemporaryDirectory()
        self.addCleanup(holder.cleanup)
        worktree = Path(holder.name) / name
        subprocess.run(
            ["git", "-C", str(self.root), "worktree", "add", "-q", str(worktree), "-b", name], check=True
        )
        return worktree

    def draft(self, value, name="draft.json"):
        path = self.root / ".dag" / name
        path.write_text(json.dumps(value), encoding="utf-8")
        return f".dag/{name}"

    def test_default_path_resolves_to_the_main_worktree_root(self):
        self.write(dag([node("A")]))
        deep = self.root / "src" / "deep"
        deep.mkdir(parents=True)
        self.assertIn("fixture", self.run_in(deep, "status").stdout)
        worktree = self.linked_worktree("linked")
        status = json.loads(self.run_in(worktree, "status", "--json").stdout)
        self.assertEqual(Path(status["control_plane_root"]).resolve(), self.root.resolve())

    def test_path_resolution_falls_back_outside_git(self):
        with tempfile.TemporaryDirectory() as plain:
            target = Path(plain) / ".dag"
            target.mkdir()
            (target / "dag.json").write_text(json.dumps(dag([node("A")])), encoding="utf-8")
            self.run_in(plain, "update-task", "--reseal", "--reason", "fixture")
            self.assertIn("fixture", self.run_in(plain, "status").stdout)

    def test_control_plane_outside_the_main_root_is_rejected(self):
        self.write(dag([node("A")]))
        worktree = self.linked_worktree("second")
        stray = worktree / ".dag"
        stray.mkdir()
        (stray / "dag.json").write_text(json.dumps(dag([node("A")])), encoding="utf-8")
        result = self.run_in(worktree, "validate-dag", "--dag", str(stray / "dag.json"), expect=2)
        self.assertIn("main worktree root", result.stderr)

    def test_running_rejects_a_worktree_with_its_own_control_plane(self):
        self.write(dag([node("A")]))
        worktree = self.linked_worktree("own-dag")
        (worktree / ".dag").mkdir()
        (worktree / ".dag" / "dag.json").write_text("{}", encoding="utf-8")
        result = self.run_cmd("update-task", "A", "running", "--worktree", str(worktree), expect=3)
        self.assertIn("second control plane", result.stderr)

    def test_init_installs_a_draft_and_consumes_it(self):
        value = dag([node("A")])
        value["planning_status"] = "awaiting_approval"
        value["approval_ref"] = None
        ref = self.draft(value)
        self.run_cmd("update-task", "--init", ref)
        self.assertEqual(json.loads(self.path.read_text())["dag_id"], "fixture")
        self.assertFalse((self.root / ".dag" / "draft.json").exists())

    def test_init_refuses_to_replace_an_existing_control_file(self):
        self.write(dag([node("A")]))
        ref = self.draft(dag([node("B")]))
        result = self.run_cmd("update-task", "--init", ref, expect=3)
        self.assertIn("already exists", result.stderr)
        self.assertEqual([n["id"] for n in json.loads(self.path.read_text())["nodes"]], ["A"])

    def test_init_rejects_an_invalid_draft(self):
        broken = dag([node("A", depends=("missing",))])
        ref = self.draft(broken)
        result = self.run_cmd("update-task", "--init", ref, expect=3)
        self.assertIn("not a valid DAG", result.stderr)
        self.assertFalse(self.path.exists())

    def test_hand_edited_control_file_is_rejected(self):
        self.awaiting([node("A")])
        tampered = json.loads(self.path.read_text())
        tampered["planning_status"] = "approved"
        tampered["approval_ref"] = "someone@example.com"
        self.path.write_text(json.dumps(tampered), encoding="utf-8")
        for command in ("validate-dag", "status", "ready-tasks"):
            result = self.run_cmd(command, expect=2)
            self.assertIn("modified outside this runtime", result.stderr)
        result = self.run_cmd("update-task", "A", "running", "--worktree", str(self.root), expect=3)
        self.assertIn("modified outside this runtime", result.stderr)

    def test_missing_seal_is_rejected(self):
        self.awaiting([node("A")])
        (self.root / ".dag" / ".dag.json.seal").unlink()
        result = self.run_cmd("validate-dag", expect=2)
        self.assertIn("no integrity seal", result.stderr)

    def test_reseal_is_a_recorded_repair(self):
        self.awaiting([node("A")])
        tampered = json.loads(self.path.read_text())
        tampered["objective"] = "repaired after a merge"
        self.path.write_text(json.dumps(tampered), encoding="utf-8")
        self.run_cmd("update-task", "--reseal", "--reason", "resolved a merge conflict")
        self.run_cmd("validate-dag")
        saved = json.loads(self.path.read_text())
        self.assertEqual(saved["reseal"]["reason"], "resolved a merge conflict")
        self.assertTrue(saved["reseal"]["at"])

    def test_runtime_transitions_keep_the_seal_valid(self):
        self.awaiting([node("A"), node("B")])
        self.approve_as("session-plan")
        self.start("A")
        self.run_cmd("update-task", "A", "failed", "--reason", "stuck")
        self.run_cmd("validate-dag")

    def test_archived_copies_carry_no_seal(self):
        self.write(dag([node("A")]))
        instruction = self.root / ".dag" / "sources" / "abandon.md"
        instruction.parent.mkdir(parents=True, exist_ok=True)
        instruction.write_text("user: drop it\n", encoding="utf-8")
        self.run_cmd("update-task", "--abandon", "--reason", "changed", "--reference", ".dag/sources/abandon.md")
        self.assertFalse((self.root / ".dag" / ".dag.json.seal").exists())
        archived = list((self.root / ".dag" / "archive").glob("fixture-*.json"))
        self.assertEqual(len(archived), 1)
        self.assertEqual(list((self.root / ".dag" / "archive").glob("*.seal")), [])

    def test_approval_requires_a_decomposition_review(self):
        self.awaiting([node("A")])
        approval = self.root / ".dag" / "sources" / "approval.md"
        approval.parent.mkdir(parents=True, exist_ok=True)
        approval.write_text("approved\n", encoding="utf-8")
        result = self.run_cmd("update-task", "--planning-status", "approved",
                              "--reference", ".dag/sources/approval.md", expect=3)
        self.assertIn("no decomposition review", result.stderr)

    def test_blocking_design_findings_prevent_approval(self):
        self.awaiting([node("A"), node("B")])
        self.design_review([
            {"severity": "important", "kind": "missing_dependency", "nodes": ["B"],
             "detail": "B consumes A's interface but declares no dependency"},
        ])
        saved = json.loads(self.path.read_text())["decomposition_review"]
        self.assertEqual(saved["verdict"], "needs_changes")
        approval = self.root / ".dag" / "sources" / "approval.md"
        approval.parent.mkdir(parents=True, exist_ok=True)
        approval.write_text("approved\n", encoding="utf-8")
        result = self.run_cmd("update-task", "--planning-status", "approved",
                              "--reference", ".dag/sources/approval.md", expect=3)
        self.assertIn("blocking findings", result.stderr)

    def test_minor_findings_do_not_block_approval(self):
        self.awaiting([node("A")])
        self.design_review([{"severity": "minor", "kind": "granularity", "nodes": ["A"], "detail": "title is vague"}])
        self.assertEqual(json.loads(self.path.read_text())["decomposition_review"]["verdict"], "approved")
        self.approve_as("session-plan")
        self.assertEqual(json.loads(self.path.read_text())["planning_status"], "approved")

    def test_editing_the_plan_invalidates_its_review(self):
        self.awaiting([node("A")])
        self.design_review()
        value = json.loads(self.path.read_text())
        value["nodes"].append(node("B"))
        self.write(value)
        approval = self.root / ".dag" / "sources" / "approval.md"
        approval.parent.mkdir(parents=True, exist_ok=True)
        approval.write_text("approved\n", encoding="utf-8")
        result = self.run_cmd("update-task", "--planning-status", "approved",
                              "--reference", ".dag/sources/approval.md", expect=3)
        self.assertIn("changed after its decomposition review", result.stderr)

    def test_execution_state_does_not_invalidate_a_review(self):
        self.awaiting([node("A"), node("B")])
        self.approve_as("session-plan")
        before = json.loads(self.path.read_text())["decomposition_review"]["fingerprint"]
        self.start("A")
        self.run_cmd("update-task", "A", "failed", "--reason", "stuck")
        self.run_cmd("validate-dag")
        self.assertEqual(json.loads(self.path.read_text())["decomposition_review"]["fingerprint"], before)

    def test_design_review_artifact_must_reference_real_nodes(self):
        self.awaiting([node("A")])
        fingerprint = json.loads(self.run_cmd("status", "--plan-view").stdout)["plan_fingerprint"]
        folder = self.root / ".dag" / "artifacts" / "bad-review"
        folder.mkdir(parents=True)
        entries = []
        for lane in ("requirements", "graph", "execution"):
            artifact = folder / f"{lane}.json"
            findings = [{"id": "ghost-1", "severity": "critical", "kind": "coverage",
                         "nodes": ["ghost"], "detail": "invented node"}] if lane == "requirements" else []
            artifact.write_text(json.dumps({
                "dag_id": "fixture", "plan_fingerprint": fingerprint, "mode": "full", "lane": lane,
                "findings": findings, "checks_performed": ["x"],
            }), encoding="utf-8")
            entries.append({"lane": lane, "ref": str(artifact.relative_to(self.root))})
        manifest = folder / "manifest.json"
        manifest.write_text(json.dumps({
            "dag_id": "fixture", "plan_fingerprint": fingerprint, "mode": "full", "reviews": entries,
        }), encoding="utf-8")
        result = self.run_cmd(
            "update-task", "--decomposition-review", str(manifest.relative_to(self.root)), expect=3
        )
        self.assertIn("existing node IDs", result.stderr)

    def test_plan_review_barrier_requires_every_lane_at_once(self):
        self.awaiting([node("A")])
        fingerprint = json.loads(self.run_cmd("status", "--plan-view").stdout)["plan_fingerprint"]
        folder = self.root / ".dag" / "artifacts" / "partial-review"
        folder.mkdir(parents=True)
        entries = []
        for lane in ("requirements", "graph"):
            report = folder / f"{lane}.json"
            report.write_text(json.dumps({
                "dag_id": "fixture", "plan_fingerprint": fingerprint, "mode": "full", "lane": lane,
                "findings": [], "checks_performed": [f"{lane} checks"],
            }), encoding="utf-8")
            entries.append({"lane": lane, "ref": str(report.relative_to(self.root))})
        manifest = folder / "manifest.json"
        manifest.write_text(json.dumps({
            "dag_id": "fixture", "plan_fingerprint": fingerprint, "mode": "full", "reviews": entries,
        }), encoding="utf-8")
        before = self.path.read_bytes()
        result = self.run_cmd(
            "update-task", "--decomposition-review", str(manifest.relative_to(self.root)), expect=3
        )
        self.assertIn("every requested lane exactly once", result.stderr)
        self.assertEqual(self.path.read_bytes(), before)

    def test_local_plan_fix_needs_only_affected_review_lanes(self):
        self.awaiting([node("A"), node("B")])
        self.design_review([
            {"id": "edge-1", "severity": "important", "kind": "missing_dependency", "nodes": ["B"],
             "detail": "B needs A"},
        ])
        fixed = dag([node("A"), node("B", depends=("A",))])
        fixed["planning_status"] = "awaiting_approval"
        fixed["approval_ref"] = None
        self.run_cmd("update-task", "--amend", self.draft(fixed, name="fixed-edge.json"))
        pending = json.loads(self.path.read_text())["decomposition_review"]
        self.assertEqual(pending["mode"], "repair")
        self.assertEqual(pending["required_lanes"], ["graph"])
        self.design_review()
        reviewed = json.loads(self.path.read_text())["decomposition_review"]
        self.assertEqual(reviewed["mode"], "repair")
        self.assertEqual(reviewed["verdict"], "approved")

    def test_deliverable_change_requires_a_new_full_review(self):
        self.awaiting([node("A")])
        self.design_review()
        changed = json.loads(self.path.read_text())
        changed["objective"] = "A different observable outcome"
        changed["decomposition_review"] = None
        self.run_cmd("update-task", "--amend", self.draft(changed, name="new-outcome.json"))
        self.assertIsNone(json.loads(self.path.read_text())["decomposition_review"])

    def test_preflight_rejects_unsafe_git_ranges_and_bad_shell(self):
        plan = [node("A")]
        plan[0]["verification"] = [
            {"id": "V1", "run": "git diff --name-only HEAD~1 HEAD", "expect": "none", "covers": ["AC1"]},
            {"id": "V2", "run": "if then", "expect": "exit 0", "covers": ["AC1"]},
        ]
        self.awaiting(plan)
        result = self.run_cmd("preflight-plan", expect=1)
        self.assertIn("recorded base_ref..head_ref", result.stderr)
        self.assertIn("invalid shell syntax", result.stderr)

    def test_preflight_rejects_directory_read_first_and_start_does_too(self):
        self.awaiting([node("A")])
        (self.root / "docs").mkdir()
        value = json.loads(self.path.read_text())
        value["nodes"][0]["read_first"] = ["docs"]
        value["planning_status"] = "awaiting_approval"
        value["approval_ref"] = None
        self.run_cmd("update-task", "--amend", self.draft(value, name="directory-read-first.json"))
        result = self.run_cmd("preflight-plan", expect=1)
        self.assertIn("regular files, not directories", result.stderr)

    def test_init_refuses_a_pre_approved_draft(self):
        value = dag([node("A")])
        value["planning_status"] = "approved"
        ref = self.draft(value)
        result = self.run_cmd("update-task", "--init", ref, expect=3)
        self.assertIn("starts as 'draft' or 'awaiting_approval'", result.stderr)

    def test_amend_replaces_the_plan_and_requests_a_scoped_repair_review(self):
        self.awaiting([node("A"), node("B")])
        self.design_review([
            {"severity": "important", "kind": "missing_dependency", "nodes": ["B"], "detail": "B needs A"},
        ])
        fixed = dag([node("A"), node("B", depends=("A",))])
        fixed["planning_status"] = "awaiting_approval"
        fixed["approval_ref"] = None
        ref = self.draft(fixed, name="amended.json")
        self.run_cmd("update-task", "--amend", ref)
        saved = json.loads(self.path.read_text())
        self.assertEqual(saved["nodes"][1]["depends_on"], ["A"])
        self.assertEqual(saved["decomposition_review"]["mode"], "repair")
        self.assertEqual(saved["decomposition_review"]["required_lanes"], ["graph"])
        self.assertEqual(saved["decomposition_review"]["open_findings"][0]["id"], "finding-1")
        self.assertTrue((self.root / ".dag" / "amended.json").exists())
        self.assertEqual(saved["replans"][-1]["ref"], ".dag/amended.json")
        self.design_review()
        self.approve_as("session-plan")
        self.assertEqual(json.loads(self.path.read_text())["planning_status"], "approved")

    def test_amend_refuses_an_approved_or_started_plan(self):
        self.awaiting([node("A")])
        self.approve_as("session-plan")
        ref = self.draft(dag([node("A")]), name="amended.json")
        result = self.run_cmd("update-task", "--amend", ref, expect=3)
        self.assertIn("--revise", result.stderr)

    def test_amend_keeps_the_same_effort(self):
        self.awaiting([node("A")])
        other = dag([node("A")])
        other["dag_id"] = "different"
        other["planning_status"] = "awaiting_approval"
        other["approval_ref"] = None
        ref = self.draft(other, name="amended.json")
        result = self.run_cmd("update-task", "--amend", ref, expect=3)
        self.assertIn("must stay 'fixture'", result.stderr)

    def live_plan(self, nodes):
        """An approved, mid-flight DAG the controller may reorganise."""
        self.awaiting(nodes)
        self.approve_as("session-plan")
        return json.loads(self.path.read_text())

    def revise(self, proposed, *, name="revision.json", reason="execution disproved the slice",
               review=None, expect=0):
        args = ["update-task", "--revise", self.draft(proposed, name=name), "--reason", reason]
        if review:
            args += ["--revision-review", review]
        return self.run_cmd(*args, expect=expect)

    def scoped_review(self, findings=(), name="scoped-review.json"):
        artifact = self.root / ".dag" / "artifacts" / name
        artifact.parent.mkdir(parents=True, exist_ok=True)
        artifact.write_text(json.dumps(
            {"dag_id": "fixture", "findings": list(findings),
             "checks_performed": ["blast radius", "interface continuity"]}
        ), encoding="utf-8")
        return str(artifact.relative_to(self.root))

    def test_revise_reorganises_a_leaf_without_ceremony(self):
        current = self.live_plan([node("A"), node("B")])
        proposed = copy.deepcopy(current)
        proposed["nodes"][1]["read_first"] = ["docs/spec.md"]
        proposed["nodes"][1]["title"] = "Node B, re-scoped"
        self.revise(proposed)
        saved = json.loads(self.path.read_text())
        self.assertEqual(saved["planning_status"], "approved")
        self.assertEqual(saved["nodes"][1]["read_first"], ["docs/spec.md"])
        self.assertEqual(saved["replans"][-1]["retouched"], ["B"])
        self.assertEqual(saved["replans"][-1]["reason"], "execution disproved the slice")
        self.assertEqual(saved["approval_ref"], current["approval_ref"])

    def test_revise_cannot_change_what_the_project_delivers(self):
        current = self.live_plan([node("A")])
        proposed = copy.deepcopy(current)
        proposed["global_acceptance"] = [{"id": "G1", "criterion": "something else entirely"}]
        result = self.revise(proposed, expect=3)
        self.assertIn("global_acceptance", result.stderr)
        self.assertIn("--amend", result.stderr)

    def test_revise_escalates_when_a_node_is_dropped(self):
        current = self.live_plan([node("A"), node("B", depends=("A",))])
        proposed = copy.deepcopy(current)
        proposed["nodes"] = [n for n in proposed["nodes"] if n["id"] != "A"]
        proposed["nodes"][0]["depends_on"] = []
        result = self.revise(proposed, expect=3)
        self.assertIn("--revision-review", result.stderr)
        self.assertIn("still covered once work leaves the plan", result.stderr)
        self.revise(proposed, name="r2.json", review=self.scoped_review())
        saved = json.loads(self.path.read_text())
        self.assertEqual([n["id"] for n in saved["nodes"]], ["B"])
        self.assertEqual(saved["replans"][-1]["dropped"], ["A"])

    def test_revise_escalates_when_an_interface_moves(self):
        current = self.live_plan([node("A"), node("B", depends=("A",))])
        proposed = copy.deepcopy(current)
        proposed["nodes"][0]["outputs"] = ["a completely different artifact"]
        result = self.revise(proposed, expect=3)
        self.assertIn("--revision-review", result.stderr)
        self.revise(proposed, name="r2.json", review=self.scoped_review())
        self.assertEqual(json.loads(self.path.read_text())["nodes"][0]["outputs"],
                         ["a completely different artifact"])

    def test_revise_adding_a_node_needs_no_review(self):
        current = self.live_plan([node("A")])
        proposed = copy.deepcopy(current)
        proposed["nodes"].append(node("C", depends=("A",)))
        self.revise(proposed)
        saved = json.loads(self.path.read_text())
        self.assertEqual(saved["replans"][-1]["added"], ["C"])
        self.assertEqual(saved["planning_status"], "approved")

    def test_scoped_review_findings_block_the_revision(self):
        current = self.live_plan([node("A"), node("B", depends=("A",))])
        proposed = copy.deepcopy(current)
        proposed["nodes"][0]["outputs"] = ["something else"]
        review = self.scoped_review([
            {"severity": "important", "kind": "missing_dependency", "nodes": ["B"],
             "detail": "B consumes A's old output and nothing replaces it"},
        ])
        result = self.revise(proposed, review=review, expect=3)
        self.assertIn("blocking finding", result.stderr)
        self.assertEqual(json.loads(self.path.read_text())["nodes"][0]["outputs"], ["output A"])

    def test_revise_freezes_running_and_done_contracts(self):
        self.live_plan([node("A"), node("B")])
        self.start("A")
        proposed = json.loads(self.path.read_text())
        proposed["nodes"][0]["objective"] = "something the running worker never received"
        result = self.revise(proposed, expect=3)
        self.assertIn("is running and its contract is frozen", result.stderr)

    def test_revise_can_rebrief_a_failed_node(self):
        self.live_plan([node("A")])
        self.start("A")
        self.run_cmd("update-task", "A", "failed", "--reason", "brief was wrong")
        proposed = json.loads(self.path.read_text())
        proposed["nodes"][0]["objective"] = "Deliver A with the brief execution proved it needs"
        self.revise(proposed, reason="retry with a corrected brief")
        saved = json.loads(self.path.read_text())
        self.assertEqual(saved["nodes"][0]["objective"], "Deliver A with the brief execution proved it needs")
        self.assertEqual(len(saved["nodes"][0]["attempts"]), 1)

    def test_revision_drift_from_its_review_is_reported(self):
        current = self.live_plan([node("A")])
        proposed = copy.deepcopy(current)
        proposed["nodes"][0]["title"] = "Node A, retitled"
        self.revise(proposed)
        result = self.run_cmd("validate-dag")
        self.assertIn("revised 1 time(s) since its decomposition review", result.stdout + result.stderr)

    def broken_plan(self, nodes):
        """An approved DAG with A done, declared no longer fit for purpose."""
        self.awaiting(nodes)
        self.approve_as("session-plan")
        self.complete("A")
        self.run_cmd("update-task", "--planning-status", "replan_required",
                     "--reference", ".dag/sources/fixture.md")
        return json.loads(self.path.read_text())

    def test_amend_reworks_unstarted_work_and_keeps_the_record(self):
        current = self.broken_plan([node("A"), node("B")])
        proposed = copy.deepcopy(current)
        proposed["nodes"] = [proposed["nodes"][0], node("C", depends=("A",))]
        ref = self.draft(proposed, name="replan.json")
        self.run_cmd("update-task", "--amend", ref)
        saved = json.loads(self.path.read_text())
        self.assertEqual([n["id"] for n in saved["nodes"]], ["A", "C"])
        self.assertEqual(saved["nodes"][0]["attempts"], current["nodes"][0]["attempts"])
        self.assertEqual(saved["planning_status"], "awaiting_approval")
        self.assertIsNone(saved["decomposition_review"])
        self.assertEqual(saved["replans"][-1]["added"], ["C"])
        self.assertEqual(saved["replans"][-1]["dropped"], ["B"])
        self.assertEqual(saved["replans"][-1]["kept"], ["A"])
        self.design_review()
        self.approve_as("session-plan")
        self.assertEqual(json.loads(self.path.read_text())["planning_status"], "approved")

    def test_amend_cannot_rewrite_an_execution_record(self):
        current = self.broken_plan([node("A"), node("B")])
        proposed = copy.deepcopy(current)
        proposed["nodes"][0]["attempts"] = []
        proposed["nodes"][0]["status"] = "pending"
        ref = self.draft(proposed, name="replan.json")
        result = self.run_cmd("update-task", "--amend", ref, expect=3)
        self.assertIn("execution record", result.stderr)

    def test_amend_cannot_drop_or_retouch_a_done_node(self):
        current = self.broken_plan([node("A"), node("B")])
        proposed = copy.deepcopy(current)
        proposed["nodes"] = [proposed["nodes"][1]]
        result = self.run_cmd("update-task", "--amend", self.draft(proposed, name="d1.json"), expect=3)
        self.assertIn("cannot be dropped", result.stderr)
        proposed = copy.deepcopy(current)
        proposed["nodes"][0]["scope"]["files"] = ["src/A.py", "src/extra.py"]
        result = self.run_cmd("update-task", "--amend", self.draft(proposed, name="d2.json"), expect=3)
        self.assertIn("frozen", result.stderr)

    def test_amend_can_reslice_a_failed_node(self):
        self.awaiting([node("A"), node("B")])
        self.approve_as("session-plan")
        self.start("B")
        self.run_cmd("update-task", "B", "failed", "--reason", "contract was wrong")
        self.run_cmd("update-task", "--planning-status", "replan_required",
                     "--reference", ".dag/sources/fixture.md")
        proposed = json.loads(self.path.read_text())
        proposed["nodes"][1]["objective"] = "Deliver B, correctly sliced this time"
        ref = self.draft(proposed, name="replan.json")
        self.run_cmd("update-task", "--amend", ref)
        saved = json.loads(self.path.read_text())
        self.assertEqual(saved["nodes"][1]["objective"], "Deliver B, correctly sliced this time")
        self.assertEqual(len(saved["nodes"][1]["attempts"]), 1)

    def test_a_rejected_plan_is_repairable_after_execution_started(self):
        """A blocking review verdict lands in awaiting_approval, which must stay editable."""
        self.awaiting([node("A"), node("B")])
        self.approve_as("session-plan")
        self.complete("A")
        self.run_cmd("update-task", "--planning-status", "replan_required",
                     "--reference", ".dag/sources/fixture.md")
        reworked = json.loads(self.path.read_text())
        self.run_cmd("update-task", "--amend", self.draft(reworked, name="rework.json"))
        self.design_review([
            {"severity": "critical", "kind": "coverage", "nodes": ["B"], "detail": "nothing delivers G1"},
        ])
        state = json.loads(self.path.read_text())
        self.assertEqual(state["planning_status"], "awaiting_approval")
        self.assertEqual(state["decomposition_review"]["verdict"], "needs_changes")

        fixed = copy.deepcopy(state)
        fixed["nodes"].append(node("G1", depends=("A",)))
        self.run_cmd("update-task", "--amend", self.draft(fixed, name="fixed.json"))
        saved = json.loads(self.path.read_text())
        self.assertEqual([n["id"] for n in saved["nodes"]], ["A", "B", "G1"])
        self.assertEqual(saved["nodes"][0]["status"], "done")
        self.assertEqual(len(saved["nodes"][0]["attempts"]), 1)
        self.design_review()
        self.approve_as("session-plan")
        self.assertEqual(json.loads(self.path.read_text())["planning_status"], "approved")

    def test_every_amendment_is_recorded_and_its_draft_survives(self):
        """`replans` points at the proposed plan, so the file it names must still be there."""
        self.awaiting([node("A")])
        proposed = json.loads(self.path.read_text())
        proposed["nodes"][0]["title"] = "Node A, retitled"
        ref = self.draft(proposed, name="first.json")
        self.run_cmd("update-task", "--amend", ref)
        saved = json.loads(self.path.read_text())
        self.assertEqual(saved["replans"][-1]["ref"], ref)
        self.assertEqual(saved["replans"][-1]["kind"], "amendment")
        self.assertTrue((self.root / ref).exists())

    def test_amend_requires_a_declared_break_and_a_settled_graph(self):
        self.awaiting([node("A"), node("B")])
        self.approve_as("session-plan")
        proposed = json.loads(self.path.read_text())
        result = self.run_cmd("update-task", "--amend", self.draft(proposed, name="d1.json"), expect=3)
        self.assertIn("replan_required", result.stderr)
        self.start("A")
        self.run_cmd("update-task", "--planning-status", "replan_required",
                     "--reference", ".dag/sources/fixture.md")
        proposed = json.loads(self.path.read_text())
        result = self.run_cmd("update-task", "--amend", self.draft(proposed, name="d2.json"), expect=3)
        self.assertIn("settle running nodes", result.stderr)

    def test_failed_convergence_still_belongs_to_gap_nodes(self):
        self.awaiting([node("A")])
        self.approve_as("session-plan")
        self.complete("A")
        report = self.root / ".dag" / "artifacts" / "conv.md"
        report.parent.mkdir(parents=True, exist_ok=True)
        report.write_text("gap\n", encoding="utf-8")
        self.run_cmd("update-task", "--convergence", "failed",
                     "--reference", ".dag/artifacts/conv.md", "--gap", "G1 uncovered")
        proposed = json.loads(self.path.read_text())
        self.assertEqual(proposed["planning_status"], "replan_required")
        result = self.run_cmd("update-task", "--amend", self.draft(proposed, name="d.json"), expect=3)
        self.assertIn("--add-gap-nodes", result.stderr)

    def test_archive_requires_a_complete_dag(self):
        self.write(dag([node("A")]))
        result = self.run_cmd("update-task", "--archive", expect=3)
        self.assertIn("not 'complete'", result.stderr)
        self.assertTrue(self.path.exists())

    def test_archive_retires_a_complete_dag(self):
        self.awaiting([node("A")])
        self.approve_as("session-plan")
        self.complete("A")
        report = self.root / ".dag" / "artifacts" / "conv.md"
        report.parent.mkdir(parents=True, exist_ok=True)
        report.write_text("passed\n", encoding="utf-8")
        self.run_cmd("update-task", "--convergence", "passed", "--reference", ".dag/artifacts/conv.md")
        self.run_cmd("update-task", "--planning-status", "complete", "--reference", ".dag/artifacts/conv.md")
        self.run_cmd("update-task", "--archive")
        self.assertFalse(self.path.exists())
        archived = list((self.root / ".dag" / "archive").glob("fixture-*.json"))
        self.assertEqual(len(archived), 1)
        saved = json.loads(archived[0].read_text())
        self.assertEqual(saved["planning_status"], "complete")
        self.assertNotIn("abandon_reason", saved)

    def test_abandon_requires_the_users_persisted_instruction(self):
        self.write(dag([node("A")]))
        result = self.run_cmd("update-task", "--abandon", "--reason", "superseded",
                              "--reference", ".dag/sources/never-written.md", expect=3)
        self.assertIn("does not exist", result.stderr)
        self.assertTrue(self.path.exists())

    def test_abandon_records_reason_and_instruction(self):
        self.write(dag([node("A")]))
        instruction = self.root / ".dag" / "sources" / "abandon.md"
        instruction.parent.mkdir(parents=True, exist_ok=True)
        instruction.write_text("user: drop this plan\n", encoding="utf-8")
        self.run_cmd("update-task", "--abandon", "--reason", "requirements changed",
                     "--reference", ".dag/sources/abandon.md")
        self.assertFalse(self.path.exists())
        archived = list((self.root / ".dag" / "archive").glob("fixture-*.json"))
        saved = json.loads(archived[0].read_text())
        self.assertEqual(saved["abandon_reason"], "requirements changed")
        self.assertEqual(saved["abandon_ref"], ".dag/sources/abandon.md")
        self.assertTrue(saved["archived_at"])

    def test_retiring_is_refused_while_a_node_runs(self):
        self.write(dag([node("A")]))
        self.start("A")
        instruction = self.root / ".dag" / "sources" / "abandon.md"
        instruction.parent.mkdir(parents=True, exist_ok=True)
        instruction.write_text("user: stop\n", encoding="utf-8")
        for args in (("--archive",), ("--abandon", "--reason", "stop", "--reference", ".dag/sources/abandon.md")):
            result = self.run_cmd("update-task", *args, expect=3)
            self.assertIn("running nodes first", result.stderr)
        self.assertTrue(self.path.exists())

    def test_parallel_nodes_cannot_share_worktree(self):
        self.write(dag([node("A"), node("B")]))
        self.start("A")
        result = self.run_cmd(
            "update-task", "B", "running", "--worktree", str(self.root), expect=3,
        )
        self.assertIn("already uses this worktree", result.stderr)

    def test_blocked_upstream_and_resume(self):
        self.write(dag([node("A"), node("C", depends=("A",))]))
        self.start("A")
        self.run_cmd("update-task", "A", "blocked", "--reason", "missing contract")
        ready = json.loads(self.run_cmd("ready-tasks", "--json").stdout)
        self.assertEqual(ready["candidates"], [])
        status = json.loads(self.run_cmd("status", "--json").stdout)
        self.assertEqual(status["counts"]["blocked"], 1)
        self.assertTrue(any(item["node"] == "C" for item in status["critical_blockers"]))
        self.start("A")
        resumed = json.loads(self.path.read_text())
        self.assertEqual(resumed["nodes"][0]["status"], "running")
        self.assertEqual(len(resumed["nodes"][0]["attempts"]), 2)

    def test_legal_done_and_illegal_pending_done(self):
        self.write(dag([node("A"), node("B")]))
        before = self.path.read_text()
        self.run_cmd(
            "update-task",
            "B",
            "done",
            "--handoff-ref",
            ".dag/artifacts/B/handoff.json",
            "--verification-ref",
            ".dag/artifacts/B/master.txt",
            "--summary",
            "done",
            expect=3,
        )
        self.assertEqual(self.path.read_text(), before)
        self.start("A")
        head = self.commit_node("A")
        handoff, review, master = self.artifacts("A", head)
        self.run_cmd("update-task", "A", "review", "--handoff-ref", handoff, "--review-ref", review, "--head-ref", head)
        self.run_cmd("update-task", "A", "done", "--handoff-ref", handoff, "--verification-ref", master, "--head-ref", head, "--summary", "A delivered")
        saved = json.loads(self.path.read_text())
        self.assertEqual(saved["nodes"][0]["status"], "done")
        self.assertEqual(saved["nodes"][0]["attempts"][0]["outcome"], "done")

    def test_approval_and_convergence_gates(self):
        value = dag([node("A")])
        value["planning_status"] = "awaiting_approval"
        value["approval_ref"] = None
        self.write(value)
        self.run_cmd("update-task", "A", "running", expect=3)
        self.run_cmd(
            "update-task", "--planning-status", "approved",
            "--reference", ".dag/sources/missing-approval.md", expect=3,
        )
        approval = self.root / ".dag" / "sources" / "approval.md"
        approval.parent.mkdir(parents=True, exist_ok=True)
        approval.write_text("approved\n", encoding="utf-8")
        self.session = "session-plan"
        self.design_review()
        self.run_cmd("update-task", "--planning-status", "approved", "--reference", ".dag/sources/approval.md")
        self.session = "session-exec"
        self.complete("A")
        self.run_cmd("update-task", "--planning-status", "complete", "--reference", "review", expect=3)
        convergence = self.root / ".dag" / "artifacts" / "convergence.md"
        convergence.parent.mkdir(parents=True, exist_ok=True)
        convergence.write_text("passed\n", encoding="utf-8")
        self.run_cmd("update-task", "--convergence", "passed", "--reference", ".dag/artifacts/convergence.md")
        self.run_cmd("update-task", "--planning-status", "complete", "--reference", ".dag/artifacts/convergence.md")
        self.run_cmd("validate-dag")

    def test_failed_convergence_survives_gap_node_replan(self):
        self.write(dag([node("A")]))
        self.complete("A")
        convergence = self.root / ".dag" / "artifacts" / "convergence.md"
        convergence.parent.mkdir(parents=True, exist_ok=True)
        convergence.write_text("missing original requirement\n", encoding="utf-8")
        self.run_cmd(
            "update-task",
            "--convergence",
            "failed",
            "--reference",
            ".dag/artifacts/convergence.md",
            "--gap",
            "missing original requirement",
        )
        gap_plan = self.root / ".dag" / "artifacts" / "gap-plan.json"
        gap_plan.write_text(json.dumps({
            "dag_id": "fixture",
            "addresses_gaps": ["missing original requirement"],
            "nodes": [node("GAP", depends=("A",))],
        }), encoding="utf-8")
        self.run_cmd("update-task", "--add-gap-nodes", ".dag/artifacts/gap-plan.json")
        self.run_cmd("validate-dag")
        status = json.loads(self.run_cmd("status", "--json").stdout)
        self.assertTrue(any(item["node"] == "<convergence>" for item in status["critical_blockers"]))

    def test_done_rejects_missing_or_unapproved_evidence(self):
        self.write(dag([node("A")]))
        self.start("A")
        head = self.commit_node("A")
        handoff, review, master = self.artifacts("A", head, approved=False)
        result = self.run_cmd(
            "update-task", "A", "review", "--handoff-ref", handoff,
            "--review-ref", review, "--head-ref", head,
        )
        self.assertIn("needs_fixes", result.stdout)
        self.run_cmd(
            "update-task", "A", "done", "--handoff-ref", handoff,
            "--verification-ref", master, "--head-ref", head, "--summary", "not done", expect=3,
        )
        saved = json.loads(self.path.read_text())
        self.assertEqual(saved["nodes"][0]["status"], "running")

        missing = ".dag/artifacts/A/missing.json"
        self.run_cmd(
            "update-task", "A", "review", "--handoff-ref", missing,
            "--review-ref", missing, "--head-ref", head, expect=3,
        )

    def test_done_rejects_missing_master_artifact_after_approval(self):
        self.write(dag([node("A")]))
        self.start("A")
        head = self.commit_node("A")
        handoff, review, _ = self.artifacts("A", head)
        self.run_cmd(
            "update-task", "A", "review", "--handoff-ref", handoff,
            "--review-ref", review, "--head-ref", head,
        )
        result = self.run_cmd(
            "update-task", "A", "done", "--handoff-ref", handoff,
            "--verification-ref", ".dag/artifacts/A/not-there.json",
            "--head-ref", head, "--summary", "not done", expect=3,
        )
        self.assertIn("does not exist", result.stderr)

    def test_scope_violation_is_rejected_by_review_gate(self):
        value = dag([node("A")])
        self.write(value)
        self.start("A")
        path = self.root / "outside.py"
        path.write_text("BAD = True\n", encoding="utf-8")
        subprocess.run(["git", "-C", str(self.root), "add", "outside.py"], check=True)
        subprocess.run(["git", "-C", str(self.root), "commit", "-qm", "outside scope"], check=True)
        head = subprocess.run(
            ["git", "-C", str(self.root), "rev-parse", "HEAD"], text=True, capture_output=True, check=True
        ).stdout.strip()
        folder = self.root / ".dag" / "artifacts" / "A"
        folder.mkdir(parents=True)
        handoff = folder / "handoff.json"
        handoff.write_text("{}", encoding="utf-8")
        review = folder / "review.json"
        review.write_text("{}", encoding="utf-8")
        result = self.run_cmd(
            "update-task", "A", "review",
            "--handoff-ref", str(handoff.relative_to(self.root)),
            "--review-ref", str(review.relative_to(self.root)), "--head-ref", head, expect=3,
        )
        self.assertIn("scope violation", result.stderr)

    def review(self, node_id, head, *, round_number=1, expect=0, **kwargs):
        handoff, review, _ = self.artifacts(node_id, head, round_number=round_number, **kwargs)
        return self.run_cmd(
            "update-task", node_id, "review", "--handoff-ref", handoff,
            "--review-ref", review, "--head-ref", head, expect=expect,
        )

    def last_review(self, node_id):
        node_state = next(n for n in json.loads(self.path.read_text())["nodes"] if n["id"] == node_id)
        return node_state["attempts"][-1]["reviews"][-1]

    def test_blocking_finding_must_be_inside_node_scope(self):
        self.write(dag([node("A")]))
        self.start("A")
        head = self.commit_node("A")
        result = self.review("A", head, approved=False, expect=3, blocking=[
            {"severity": "critical", "path": "src/other.py", "detail": "caller breaks"},
        ])
        self.assertIn("record it under controller_decisions", result.stderr)

    def test_blocking_finding_requires_a_path(self):
        self.write(dag([node("A")]))
        self.start("A")
        head = self.commit_node("A")
        result = self.review("A", head, approved=False, expect=3, blocking=[
            {"severity": "critical", "detail": "something is wrong"},
        ])
        self.assertIn("path: must be the project-relative file", result.stderr)

    def test_escalation_must_be_outside_node_scope(self):
        self.write(dag([node("A")]))
        self.start("A")
        head = self.commit_node("A")
        result = self.review("A", head, expect=3, escalations=[
            {"severity": "important", "path": "src/A.py", "detail": "fixable here"},
        ])
        self.assertIn("record it under blocking_findings", result.stderr)

    def test_escalation_blocks_completion_and_names_its_paths(self):
        self.write(dag([node("A")]))
        self.start("A")
        head = self.commit_node("A")
        result = self.review("A", head, escalations=[
            {"severity": "important", "path": "src/caller.py", "detail": "A's new signature breaks this caller"},
        ])
        self.assertIn("escalated", result.stdout)
        self.assertEqual(self.last_review("A")["outcome"], "escalated")
        self.assertEqual(self.last_review("A")["escalated_paths"], ["src/caller.py"])
        master = ".dag/artifacts/A/master.json"
        result = self.run_cmd(
            "update-task", "A", "done", "--handoff-ref", ".dag/artifacts/A/handoff-1.json",
            "--verification-ref", master, "--head-ref", head, "--summary", "x", expect=3,
        )
        self.assertIn("without an approved review or a recorded narrow resolution", result.stderr)
        status = json.loads(self.run_cmd("status", "--json").stdout)
        self.assertEqual(status["active_attempts"][0]["escalated_paths"], ["src/caller.py"])

    def test_escalation_resolves_by_assigning_an_owner_without_rereview(self):
        self.write(dag([node("A"), node("B", depends=("A",), files=["src/caller.py"])]))
        self.start("A")
        head = self.commit_node("A")
        self.review("A", head, escalations=[
            {"severity": "important", "path": "src/caller.py", "detail": "no node owns this caller"},
        ])
        result = self.review("A", head, round_number=2, expect=3)
        self.assertIn("resolve-escalation", result.stderr)
        self.run_cmd("update-task", "A", "resolve-escalation", "--owner", "src/caller.py=B")
        saved = json.loads(self.path.read_text())
        attempt = saved["nodes"][0]["attempts"][-1]
        self.assertEqual(len(attempt["reviews"]), 1)
        self.assertEqual(attempt["open_escalations"], [])
        self.assertEqual(attempt["escalation_resolution"]["owners"], [{"path": "src/caller.py", "node": "B"}])
        master = ".dag/artifacts/A/master.json"
        self.run_cmd(
            "update-task", "A", "done", "--handoff-ref", ".dag/artifacts/A/handoff-1.json",
            "--verification-ref", master, "--head-ref", head, "--summary", "A delivered",
        )

    def test_contract_question_resolves_without_rereviewing_unchanged_code(self):
        self.write(dag([node("A")]))
        self.start("A")
        head = self.commit_node("A")
        self.review("A", head, contract=[
            {"severity": "important", "path": "src/A.py", "detail": "AC1 has two plausible readings"},
        ])
        self.assertEqual(self.last_review("A")["outcome"], "cannot_verify")
        result = self.review("A", head, round_number=2, expect=3)
        self.assertIn("resolve-contract", result.stderr)
        decision = self.root / ".dag" / "artifacts" / "A" / "contract-decision.json"
        decision.write_text(json.dumps({
            "node": "A", "head_ref": head, "review_round": 1, "finding_ids": ["contract-1"],
            "verdict": "APPROVED", "changes_acceptance": False,
            "checks_performed": ["checked source wording and existing behavior"],
        }), encoding="utf-8")
        self.run_cmd(
            "update-task", "A", "resolve-contract", "--decision-ref", str(decision.relative_to(self.root))
        )
        saved = json.loads(self.path.read_text())
        attempt = saved["nodes"][0]["attempts"][-1]
        self.assertEqual(len(attempt["reviews"]), 1)
        self.assertEqual(attempt["open_contract_findings"], [])
        self.run_cmd(
            "update-task", "A", "done", "--handoff-ref", ".dag/artifacts/A/handoff-1.json",
            "--verification-ref", ".dag/artifacts/A/master.json", "--head-ref", head,
            "--summary", "A delivered",
        )

    def test_fix_review_must_verdict_each_prior_finding(self):
        self.write(dag([node("A")]))
        self.start("A")
        first = self.commit_node("A")
        self.review("A", first, approved=False)
        second = self.commit_node("A")
        handoff, review, _ = self.artifacts("A", second, round_number=2)
        report = json.loads((self.root / review).read_text())
        report["resolutions"] = []
        (self.root / review).write_text(json.dumps(report), encoding="utf-8")
        result = self.run_cmd(
            "update-task", "A", "review", "--handoff-ref", handoff,
            "--review-ref", review, "--head-ref", second, expect=3,
        )
        self.assertIn("every prior blocking finding", result.stderr)

    def test_reviewer_fix_must_be_an_independent_commit(self):
        self.write(dag([node("A")]))
        self.start("A")
        first = self.commit_node("A")
        self.review("A", first, approved=False)
        second = self.commit_node("A")
        handoff, review, _ = self.artifacts("A", second, round_number=2)
        report = json.loads((self.root / review).read_text())
        report["worker_head"] = second
        report["reviewer_fix_head"] = second
        report["resolutions"] = [{"id": "code-1", "status": "ADDRESSED", "detail": "fixed"}]
        (self.root / review).write_text(json.dumps(report), encoding="utf-8")
        result = self.run_cmd(
            "update-task", "A", "review", "--handoff-ref", handoff,
            "--review-ref", review, "--head-ref", second, expect=3,
        )
        self.assertIn("independent commit", result.stderr)

    def test_reviewer_fix_cannot_hide_a_new_blocking_finding(self):
        self.write(dag([node("A")]))
        self.start("A")
        first = self.commit_node("A")
        self.review("A", first, approved=False)
        second = self.commit_node("A")
        handoff, review, _ = self.artifacts("A", first, round_number=2)
        report = json.loads((self.root / review).read_text())
        report["head_ref"] = second
        report["worker_head"] = first
        report["reviewer_fix_head"] = second
        report["blocking_findings"] = [{
            "id": "new-defect", "severity": "critical", "path": "src/A.py", "detail": "new defect"
        }]
        report["resolutions"] = [{"id": "code-1", "status": "ADDRESSED", "detail": "fixed"}]
        (self.root / review).write_text(json.dumps(report), encoding="utf-8")
        result = self.run_cmd(
            "update-task", "A", "review", "--handoff-ref", handoff,
            "--review-ref", review, "--head-ref", second, expect=3,
        )
        self.assertIn("cannot introduce new blocking findings", result.stderr)

    def test_single_review_can_record_worker_and_reviewer_fix(self):
        self.write(dag([node("A")]))
        self.start("A")
        worker = self.commit_node("A")
        reviewer_fix = self.commit_node("A")
        folder = self.root / ".dag" / "artifacts" / "A"
        folder.mkdir(parents=True, exist_ok=True)
        handoff = folder / "handoff-single.json"
        handoff.write_text(json.dumps({
            "node": "A", "status": "DONE", "files_changed": ["src/A.py"],
            "outputs": ["output A"], "decisions": [],
            "verification": [{"command": "fixture check", "result": "exit 0"}],
            "context_used": [], "concerns": [], "unresolved": [], "downstream_notes": [],
            "commit": worker,
        }), encoding="utf-8")
        review = folder / "review-single.json"
        review.write_text(json.dumps({
            "node": "A", "round": 1, "head_ref": reviewer_fix,
            "worker_head": worker, "reviewer_fix_head": reviewer_fix,
            "spec": "NEEDS_FIXES", "quality": "NEEDS_FIXES",
            "blocking_findings": [{"id": "code-1", "severity": "critical", "path": "src/A.py", "detail": "defect"}],
            "finding_resolutions": [{"id": "code-1", "status": "ADDRESSED", "detail": "fixed"}],
            "controller_decisions": [], "contract_findings": [], "minor_findings": [],
            "out_of_scope_observations": [],
        }), encoding="utf-8")
        result = self.run_cmd(
            "update-task", "A", "review", "--handoff-ref", str(handoff.relative_to(self.root)),
            "--review-ref", str(review.relative_to(self.root)), "--head-ref", reviewer_fix,
        )
        self.assertIn("approved", result.stdout)
        saved = json.loads(self.path.read_text())["nodes"][0]["attempts"][0]
        self.assertEqual(saved["worker_head"], worker)
        self.assertEqual(saved["reviewer_fix_head"], reviewer_fix)

