            "outputs": ["output A"],
            "decisions": [],
            "verification": [{"command": "fixture check", "result": "exit 0"}],
            "context_used": [],
            "concerns": [],
            "unresolved": [],
            "downstream_notes": [],
            "commit": None,
        }), encoding="utf-8")
        (folder / "review.json").write_text(json.dumps({
            "node": "A",
            "head_ref": None,
            "round": 1,
            "worker_head": None,
